rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is the designated editor
    function isDesignatedEditor() {
      return request.auth != null && 
        (request.auth.token.email == 'work@anotherunit.xyz' || request.auth.token.firebase.sign_in_provider == 'password');
    }

    // Site settings (e.g. showWander, general options)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isDesignatedEditor();
    }

    // Archive entries
    match /entries/{entryId} {
      // Public visitors can ONLY read published entries
      allow read: if isDesignatedEditor() || resource.data.status == 'published';

      // Only the designated editor can create, update, or delete entries
      allow create: if isDesignatedEditor()
        && request.resource.data.id is string
        && request.resource.data.slug is string
        && request.resource.data.title is string
        && request.resource.data.status in ['published', 'draft'];

      allow update: if isDesignatedEditor()
        && request.resource.data.id == resource.data.id; // Preserve stable entry ID

      allow delete: if isDesignatedEditor();
    }
  }
}
